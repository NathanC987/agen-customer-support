# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: any Gemini model available to your key (flash-lite has the most generous free quota)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: embedding model for the RAG index
GEMINI_EMBED_MODEL=gemini-embedding-001

# Secret used to sign session JWTs — 32+ random chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Vector database (docker compose up -d)
QDRANT_URL=http://127.0.0.1:6333
